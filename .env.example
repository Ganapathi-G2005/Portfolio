# Copy to .env.local for development. In Vercel: Project → Settings → Environment Variables.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Chat (OpenAI) — required for the portfolio chat panel
VITE_OPENAI_API_KEY=

# Contact form (EmailJS) — optional; Contact.jsx falls back to placeholders if unset
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
